# Construit soapui-tester pour Linux (amd64) et le depose dans /out
# au lancement du conteneur (voir `make linux`).
#
# amd64 plutot que arm64 : PyQt6 n'a pas de wheel Linux arm64 precompilee sur
# PyPI, seulement x86_64 (manylinux). C'est aussi l'architecture Linux de
# bureau la plus courante.
FROM ubuntu:22.04

RUN apt-get update -qq && apt-get install -y -qq \
    python3 python3-venv python3-pip \
    libgl1 libegl1 libglib2.0-0 libxkbcommon-x11-0 libxcb-cursor0 libxcb-icccm4 \
    libxcb-image0 libxcb-keysyms1 libxcb-randr0 libxcb-render-util0 libxcb-shape0 \
    libxcb-xinerama0 libxcb-xkb1 libdbus-1-3 libfontconfig1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt ./
COPY main.py ./
COPY soapui_tester/ ./soapui_tester/
COPY gui/ ./gui/
COPY packaging/linux.spec ./packaging/linux.spec

RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install -q --upgrade pip \
    && /opt/venv/bin/pip install -q -r requirements.txt pyinstaller

RUN /opt/venv/bin/pyinstaller packaging/linux.spec --noconfirm --clean \
    --distpath dist --workpath build

CMD ["sh", "-c", "cp -r /app/dist/. /out/"]
